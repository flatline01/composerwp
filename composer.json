{
    "name": "dev/composerwp",
    "type": "project",
    "authors": [
        {
            "name": "devbox"
        }
    ],
    "require": {
        "johnpbloch/wordpress": "^7.1",
        "wpackagist-plugin/wp-graphql": "^2.23",
        "johnbillion/query-monitor": "^4.0",
        "wp-theme/twentytwentyfive": "^1.5",
        "wpackagist-plugin/redis-cache": "^3.0"
    },
     "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        },
        {
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        }
    ],
    "extra": {
        "wordpress-install-dir": "wp",
        "installer-paths": {
            "content/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ],
           "content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
           "content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "cp wp/index.php ./index.php",
            "sed -i \"s/\\/wp-blog-header/\\/wp\\/wp-blog-header/g\" index.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true,
            "composer/installers": true
        }
    }
}
